+    /**
+     * [DFO progress patch] Run an action on the selected tasks a batch at a time, with a
+     * progress dialog. This is what turns Retrieve Predictions into a progress bar.
+     *
+     * Why batching is needed: in stock Label Studio the browser sends ONE request,
+     * "POST /api/dm/actions?id=retrieve_tasks_predictions", with the selection. The server
+     * sends every selected task to the ML backend and answers only when all are done, so
+     * the page can only show a spinner. Large selections can also hit the request timeout.
+     *
+     * What this does instead:
+     *   1. Ask the server for the IDs of the selected tasks, using the hidden
+     *      "selected_task_ids" action added to label_studio/data_manager/actions/basic.py.
+     *      It receives the same selection payload (select-all, filters, exclusions), so
+     *      it resolves exactly the tasks the stock action would have processed.
+     *   2. Call the normal, unchanged action endpoint with batchSize task IDs at a time.
+     *      Each call returns when that batch is predicted, and the dialog is updated.
+     *   3. Each response includes "created" and "with_predictions" (also added in
+     *      basic.py). They split the batch into new / already predicted / missing.
+     *
+     * The server still does the actual work (calling the ML backend and saving
+     * predictions) exactly as before. Only the size of each request changes.
+     *
+     * @param {string} actionId        e.g. "retrieve_tasks_predictions"
+     * @param {object} requestParams   query params from invokeAction (id, tabID)
+     * @param {object} actionParams    request body from invokeAction (selectedItems, filters, ordering)
+     * @param {object} options         invokeAction options; options.body holds any dialog form values
+     * @returns {object} Summary in the same shape as an action response, plus the counts.
+     */
+    invokeActionInBatches: flow(function* (actionId, requestParams, actionParams, options = {}) {
+      const { title, batchSize } = BATCHED_ACTIONS[actionId];
+      const progress = openActionProgress({ title });
+
+      // apiCall() normally shows Label Studio's global error popup on a failed request.
+      // Returning true from errorHandler suppresses it, so a failed batch is reported in
+      // the progress dialog and the loop carries on with the next batch.
+      const quiet = { errorHandler: () => true };
+      const errorText = (res) =>
+        res?.response?.detail ?? res?.response?.message ?? res?.message ?? "The server returned an error.";
+
+      // Step 1: resolve the selection to task IDs (same body as the stock request)
+      const idsResult = yield self.apiCall(
+        "invokeAction",
+        { ...requestParams, id: "selected_task_ids" },
+        { body: actionParams },
+        quiet,
+      );
+
+      // No task list (request failed, or the server lacks the patched basic.py and so
+      // doesn't know "selected_task_ids"): show the error in the dialog and stop here
+      if (!idsResult || idsResult.error || !Array.isArray(idsResult.task_ids)) {
+        progress.update({ phase: "failed", message: errorText(idsResult) });
+        return idsResult;
+      }
+
+      const taskIds = idsResult.task_ids;
+      // Running totals shown in the dialog (see ProgressBody in ActionProgress.jsx)
+      const totals = { done: 0, total: taskIds.length, predicted: 0, skipped: 0, missing: 0 };
+
+      progress.update({ phase: "running", ...totals });
+
+      // Step 2: one request per batch. "yield" waits for each request to finish before
+      // sending the next, so batches run one after another and the server isn't flooded.
+      for (let i = 0; i < taskIds.length; i += batchSize) {
+        // Stop button: checked between batches, because a sent request can't be recalled
+        if (progress.isStopRequested()) break;
+
+        const batch = taskIds.slice(i, i + batchSize);
+
+        // The stock action endpoint, with the selection narrowed to just this batch.
+        // filters/ordering are cleared and no tabID is sent: the IDs are already
+        // resolved, and a filter or saved tab must not narrow them again.
+        const res = yield self.apiCall(
+          "invokeAction",
+          { id: actionId },
+          {
+            body: {
+              ...(options.body ?? {}),
+              selectedItems: { all: false, included: batch },
+              filters: null,
+              ordering: [],
+            },
+          },
+          quiet,
+        );
+
+        totals.done += batch.length;
+
+        // The request itself failed (e.g. server error or network drop): count the whole
+        // batch as missing, show the error, and carry on with the next batch
+        if (!res || res.error) {
+          totals.missing += batch.length;
+          progress.update({ ...totals, message: `A batch failed: ${errorText(res)}` });
+          continue;
+        }
+
+        // Step 3: split the batch using the counts the patched server returns.
+        //   created          = predictions saved by this request
+        //   with_predictions = tasks in the batch that now have a prediction from the
+        //                      current model version (new ones + ones that already had one)
+        // So: skipped = with_predictions - created, missing = batch - with_predictions.
+        // A server without the patched basic.py doesn't return the counts; then the whole
+        // batch is treated as predicted, which matches what stock Label Studio reports.
+        const created = res.created ?? batch.length;
+        const withPredictions = res.with_predictions ?? batch.length;
+
+        totals.predicted += created;
+        totals.skipped += Math.max(withPredictions - created, 0);
+        totals.missing += Math.max(batch.length - withPredictions, 0);
+
+        progress.update({ ...totals, phase: progress.isStopRequested() ? "stopping" : "running" });
+      }
+
+      // If Stop was clicked during the last batch, everything was still sent: report "done"
+      const stopped = progress.isStopRequested() && totals.done < totals.total;
+
+      progress.update({ ...totals, phase: stopped ? "stopped" : "done" });
+
+      // Same shape as a stock action response, so SDK listeners of
+      // actionDialogOkComplete receive what they expect
+      return {
+        processed_items: totals.done,
+        detail: `Sent ${totals.done} of ${totals.total} tasks to the model`,
+        ...totals,
+      };
+    }),
+
