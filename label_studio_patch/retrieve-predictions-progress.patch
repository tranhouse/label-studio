diff --git a/web/libs/datamanager/src/components/Common/ActionProgress/ActionProgress.jsx b/web/libs/datamanager/src/components/Common/ActionProgress/ActionProgress.jsx
new file mode 100644
index 0000000..11ba8f7
--- /dev/null
+++ b/web/libs/datamanager/src/components/Common/ActionProgress/ActionProgress.jsx
@@ -0,0 +1,167 @@
+import { Button } from "@humansignal/ui";
+import { Modal } from "../Modal/Modal";
+
+/**
+ * Progress dialog for Data Manager actions that run in batches (Retrieve Predictions).
+ *
+ * The dialog can't be closed while the action runs; the only way out is Stop, which
+ * lets the current batch finish and then stops. When the run ends the footer switches
+ * to a single Close button.
+ */
+
+const formatDuration = (ms) => {
+  if (!Number.isFinite(ms) || ms < 0) return "–";
+  const totalSeconds = Math.round(ms / 1000);
+  const minutes = Math.floor(totalSeconds / 60);
+  const seconds = totalSeconds % 60;
+  return minutes > 0 ? `${minutes} min ${seconds} s` : `${seconds} s`;
+};
+
+const Stat = ({ label, value, className = "" }) => (
+  <div className="flex flex-col">
+    <span className={`text-lg font-semibold ${className}`}>{value}</span>
+    <span className="text-xs text-neutral-content-subtle">{label}</span>
+  </div>
+);
+
+const ProgressBody = ({ state }) => {
+  const { phase, done, total, predicted, skipped, missing, startedAt, finishedAt, message } = state;
+  const percent = total > 0 ? Math.round((done / total) * 100) : 0;
+  const elapsed = (finishedAt ?? Date.now()) - startedAt;
+  const rate = done > 0 ? elapsed / done : null;
+  const remaining = rate && phase === "running" ? rate * (total - done) : null;
+
+  const heading = {
+    preparing: "Finding the selected tasks…",
+    running: `Sending tasks to the model… ${done} of ${total}`,
+    stopping: `Stopping after the current batch… ${done} of ${total}`,
+    stopped: `Stopped. ${done} of ${total} tasks were sent to the model.`,
+    done: `Finished. ${done} of ${total} tasks were sent to the model.`,
+    failed: "Retrieve Predictions failed.",
+  }[phase];
+
+  const barColor = phase === "failed" ? "bg-negative-background" : "bg-primary-emphasis";
+
+  return (
+    <div className="flex flex-col gap-4" data-testid="action-progress">
+      <div className="text-neutral-content">{heading}</div>
+
+      <div
+        className="w-full h-3 rounded-full overflow-hidden bg-neutral-surface-bold"
+        role="progressbar"
+        aria-valuemin={0}
+        aria-valuemax={100}
+        aria-valuenow={percent}
+      >
+        <div
+          className={`h-full ${barColor}`}
+          style={{ width: `${phase === "preparing" ? 0 : percent}%`, transition: "width 0.3s ease" }}
+        />
+      </div>
+
+      <div className="flex justify-between text-sm text-neutral-content-subtle">
+        <span>{percent}%</span>
+        <span>
+          Elapsed {formatDuration(elapsed)}
+          {remaining !== null && ` · about ${formatDuration(remaining)} left`}
+        </span>
+      </div>
+
+      {phase !== "preparing" && (
+        <div className="grid grid-cols-3 gap-4">
+          <Stat label="New predictions" value={predicted} className="text-positive-content" />
+          <Stat label="Already predicted (skipped)" value={skipped} />
+          <Stat
+            label="No prediction returned"
+            value={missing}
+            className={missing > 0 ? "text-negative-content" : ""}
+          />
+        </div>
+      )}
+
+      {missing > 0 && phase !== "running" && (
+        <div className="text-sm text-neutral-content-subtle">
+          Tasks with no prediction either got no boxes above the score threshold, or the ML backend
+          returned an error (check its log). Run Retrieve Predictions again to retry them; tasks that
+          already have predictions are skipped.
+        </div>
+      )}
+
+      {message && <div className="text-sm text-negative-content">{message}</div>}
+    </div>
+  );
+};
+
+/**
+ * Open the progress dialog.
+ *
+ * @param {{ title: string }} options
+ * @returns {{ update: (patch: object) => void, isStopRequested: () => boolean }}
+ */
+export const openActionProgress = ({ title }) => {
+  let stopRequested = false;
+  const state = {
+    phase: "preparing",
+    done: 0,
+    total: 0,
+    predicted: 0,
+    skipped: 0,
+    missing: 0,
+    startedAt: Date.now(),
+    finishedAt: null,
+    message: null,
+  };
+
+  const footer = () => {
+    const finished = ["done", "stopped", "failed"].includes(state.phase);
+
+    if (finished) {
+      return (
+        <div className="flex justify-end">
+          <Button onClick={() => modal.close()} data-testid="action-progress-close">
+            Close
+          </Button>
+        </div>
+      );
+    }
+
+    return (
+      <div className="flex justify-end">
+        <Button
+          look="outlined"
+          variant="neutral"
+          disabled={stopRequested}
+          onClick={() => {
+            stopRequested = true;
+            update({ phase: "stopping" });
+          }}
+          data-testid="action-progress-stop"
+        >
+          Stop
+        </Button>
+      </div>
+    );
+  };
+
+  const modal = Modal.modal({
+    title,
+    body: <ProgressBody state={{ ...state }} />,
+    footer: footer(),
+    allowClose: false,
+    closeOnClickOutside: false,
+    width: 560,
+  });
+
+  const update = (patch) => {
+    Object.assign(state, patch);
+    if (["done", "stopped", "failed"].includes(state.phase) && !state.finishedAt) {
+      state.finishedAt = Date.now();
+    }
+    modal.update({ body: <ProgressBody state={{ ...state }} />, footer: footer() });
+  };
+
+  return {
+    update,
+    isStopRequested: () => stopRequested,
+  };
+};
