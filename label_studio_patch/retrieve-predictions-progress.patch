@@ -805,6 +831,89 @@ export const AppStore = types
       return result;
     }),
 
+    /**
+     * Run an action on the selected tasks a batch at a time, with a progress dialog.
+     *
+     * 1. Ask the server for the IDs of the selected tasks (the hidden
+     *    "selected_task_ids" action), so "select all", filters and exclusions are
+     *    resolved exactly as for the normal action.
+     * 2. Send the action for BATCH_SIZE tasks at a time and update the dialog after each.
+     *
+     * Small requests also avoid the gateway timeout that one large request can hit.
+     */
+    invokeActionInBatches: flow(function* (actionId, requestParams, actionParams, options = {}) {
+      const { title, batchSize } = BATCHED_ACTIONS[actionId];
+      const progress = openActionProgress({ title });
+      // Keep the error handled here instead of the global error popup
+      const quiet = { errorHandler: () => true };
+      const errorText = (res) =>
+        res?.response?.detail ?? res?.response?.message ?? res?.message ?? "The server returned an error.";
+
+      const idsResult = yield self.apiCall(
+        "invokeAction",
+        { ...requestParams, id: "selected_task_ids" },
+        { body: actionParams },
+        quiet,
+      );
+
+      if (!idsResult || idsResult.error || !Array.isArray(idsResult.task_ids)) {
+        progress.update({ phase: "failed", message: errorText(idsResult) });
+        return idsResult;
+      }
+
+      const taskIds = idsResult.task_ids;
+      const totals = { done: 0, total: taskIds.length, predicted: 0, skipped: 0, missing: 0 };
+
+      progress.update({ phase: "running", ...totals });
+
+      for (let i = 0; i < taskIds.length; i += batchSize) {
+        if (progress.isStopRequested()) break;
+
+        const batch = taskIds.slice(i, i + batchSize);
+        const res = yield self.apiCall(
+          "invokeAction",
+          { id: actionId },
+          {
+            body: {
+              ...(options.body ?? {}),
+              selectedItems: { all: false, included: batch },
+              filters: null,
+              ordering: [],
+            },
+          },
+          quiet,
+        );
+
+        totals.done += batch.length;
+
+        if (!res || res.error) {
+          totals.missing += batch.length;
+          progress.update({ ...totals, message: `A batch failed: ${errorText(res)}` });
+          continue;
+        }
+
+        // Older servers don't return the counts; treat the whole batch as predicted
+        const created = res.created ?? batch.length;
+        const withPredictions = res.with_predictions ?? batch.length;
+
+        totals.predicted += created;
+        totals.skipped += Math.max(withPredictions - created, 0);
+        totals.missing += Math.max(batch.length - withPredictions, 0);
+
+        progress.update({ ...totals, phase: progress.isStopRequested() ? "stopping" : "running" });
+      }
+
+      const stopped = progress.isStopRequested() && totals.done < totals.total;
+
+      progress.update({ ...totals, phase: stopped ? "stopped" : "done" });
+
+      return {
+        processed_items: totals.done,
+        detail: `Sent ${totals.done} of ${totals.total} tasks to the model`,
+        ...totals,
+      };
+    }),
+
     crash(options = {}) {
       if (options.redirect !== true) {
         self.destroy();
