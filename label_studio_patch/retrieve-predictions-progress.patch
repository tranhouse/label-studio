diff --git a/web/libs/datamanager/src/components/Common/ActionProgress/ActionProgress.jsx b/web/libs/datamanager/src/components/Common/ActionProgress/ActionProgress.jsx
new file mode 100644
index 0000000..dbc4687
--- /dev/null
+++ b/web/libs/datamanager/src/components/Common/ActionProgress/ActionProgress.jsx
@@ -0,0 +1,237 @@
+/**
+ * [DFO progress patch] Progress dialog for Retrieve Predictions.
+ *
+ * Stock Label Studio sends every selected task to the ML backend in ONE request and
+ * shows a spinner until the whole request returns, so there is nothing to measure
+ * progress against. The patch splits the work into small batches (see
+ * invokeActionInBatches in stores/AppStore.js). This file is only the dialog that
+ * displays the progress. It does no network calls itself.
+ *
+ * How it fits together:
+ *   AppStore.invokeActionInBatches()
+ *     ├─ calls openActionProgress() once                → dialog appears ("preparing")
+ *     ├─ after each batch calls progress.update({...})  → bar and counts move
+ *     ├─ checks progress.isStopRequested() before each  → Stop button ends the loop
+ *     └─ finally calls progress.update({phase: "done"}) → footer switches to Close
+ *
+ * Phases, in order: preparing → running (→ stopping) → done | stopped | failed
+ *
+ * The dialog can't be dismissed with Esc or by clicking outside while it runs. The
+ * only way out is Stop, which lets the current batch finish (a request already sent to
+ * the server can't be recalled) and then ends the loop.
+ */
+import { Button } from "@humansignal/ui";
+import { Modal } from "../Modal/Modal";
+
+/** Phases in which the run is over and the dialog shows a Close button. */
+const FINISHED_PHASES = ["done", "stopped", "failed"];
+
+/**
+ * Format milliseconds as "12 s" or "3 min 5 s".
+ *
+ * @param {number} ms Duration in milliseconds.
+ * @returns {string} Readable duration, or "–" if it can't be computed.
+ */
+const formatDuration = (ms) => {
+  if (!Number.isFinite(ms) || ms < 0) return "–";
+  const totalSeconds = Math.round(ms / 1000);
+  const minutes = Math.floor(totalSeconds / 60);
+  const seconds = totalSeconds % 60;
+  return minutes > 0 ? `${minutes} min ${seconds} s` : `${seconds} s`;
+};
+
+/**
+ * One number with a caption underneath, e.g. "12 / New predictions".
+ *
+ * @param {{ label: string, value: number, className?: string }} props
+ *   className colours the number (green for new predictions, red for missing ones).
+ */
+const Stat = ({ label, value, className = "" }) => (
+  <div className="flex flex-col">
+    <span className={`text-lg font-semibold ${className}`}>{value}</span>
+    <span className="text-xs text-neutral-content-subtle">{label}</span>
+  </div>
+);
+
+/**
+ * The dialog's contents: heading, bar, timings and counts.
+ *
+ * It is re-rendered from scratch on every update (see openActionProgress), so it only
+ * reads the state it is given and keeps none of its own.
+ *
+ * @param {{ state: object }} props
+ *   state.phase      current phase (see the file header)
+ *   state.done       tasks sent so far
+ *   state.total      tasks selected
+ *   state.predicted  predictions the model created in this run
+ *   state.skipped    tasks that already had a prediction from this model version
+ *   state.missing    tasks that still have no prediction (no boxes, or backend error)
+ *   state.startedAt  / state.finishedAt   timestamps for the elapsed time
+ *   state.message    error text to show, if any
+ */
+const ProgressBody = ({ state }) => {
+  const { phase, done, total, predicted, skipped, missing, startedAt, finishedAt, message } = state;
+  const percent = total > 0 ? Math.round((done / total) * 100) : 0;
+
+  // Elapsed time stops counting once the run has finished
+  const elapsed = (finishedAt ?? Date.now()) - startedAt;
+
+  // Time left = average time per task so far × tasks remaining. Only shown while
+  // running, and only once at least one batch has finished (otherwise there's no rate).
+  const msPerTask = done > 0 ? elapsed / done : null;
+  const remaining = msPerTask && phase === "running" ? msPerTask * (total - done) : null;
+
+  const heading = {
+    preparing: "Finding the selected tasks…",
+    running: `Sending tasks to the model… ${done} of ${total}`,
+    stopping: `Stopping after the current batch… ${done} of ${total}`,
+    stopped: `Stopped. ${done} of ${total} tasks were sent to the model.`,
+    done: `Finished. ${done} of ${total} tasks were sent to the model.`,
+    failed: "Retrieve Predictions failed.",
+  }[phase];
+
+  // Colour tokens come from Label Studio's design system (@humansignal/ui Tailwind config),
+  // so the bar matches the app in both light and dark themes
+  const barColor = phase === "failed" ? "bg-negative-surface" : "bg-primary-surface";
+
+  return (
+    <div className="flex flex-col gap-4" data-testid="action-progress">
+      <div className="text-neutral-content">{heading}</div>
+
+      {/* The bar: a grey track with a coloured fill whose width is the percent done.
+          role/aria attributes let screen readers announce the progress. */}
+      <div
+        className="w-full h-3 rounded-full overflow-hidden bg-neutral-border"
+        role="progressbar"
+        aria-valuemin={0}
+        aria-valuemax={100}
+        aria-valuenow={percent}
+      >
+        <div
+          className={`h-full ${barColor}`}
+          style={{ width: `${phase === "preparing" ? 0 : percent}%`, transition: "width 0.3s ease" }}
+        />
+      </div>
+
+      <div className="flex justify-between text-sm text-neutral-content-subtle">
+        <span>{percent}%</span>
+        <span>
+          Elapsed {formatDuration(elapsed)}
+          {remaining !== null && ` · about ${formatDuration(remaining)} left`}
+        </span>
+      </div>
+
+      {/* Counts appear once the task list is known */}
+      {phase !== "preparing" && (
+        <div className="grid grid-cols-3 gap-4">
+          <Stat label="New predictions" value={predicted} className="text-positive-content" />
+          <Stat label="Already predicted (skipped)" value={skipped} />
+          <Stat label="No prediction returned" value={missing} className={missing > 0 ? "text-negative-content" : ""} />
+        </div>
+      )}
+
+      {/* After the run, explain what "no prediction returned" means and how to retry */}
+      {missing > 0 && phase !== "running" && (
+        <div className="text-sm text-neutral-content-subtle">
+          Tasks with no prediction either got no boxes above the score threshold, or the ML backend returned an error
+          (check its log). Run Retrieve Predictions again to retry them; tasks that already have predictions are
+          skipped.
+        </div>
+      )}
+
+      {message && <div className="text-sm text-negative-content">{message}</div>}
+    </div>
+  );
+};
+
+/**
+ * Open the progress dialog and return a small controller for it.
+ *
+ * Label Studio's Modal.modal() renders a dialog outside the React tree and returns an
+ * object with update(newProps) and close(). The dialog's state is kept in a plain
+ * object here, and every update() re-renders the body and footer from it. That keeps
+ * this independent of MobX, which the calling store uses.
+ *
+ * @param {{ title: string }} options  Dialog title, e.g. "Retrieve Predictions".
+ * @returns {{
+ *   update: (patch: object) => void,   merge fields into the state and re-render
+ *   isStopRequested: () => boolean     true once the user has clicked Stop
+ * }}
+ */
+export const openActionProgress = ({ title }) => {
+  // Set by the Stop button and read by the batch loop in AppStore before each batch
+  let stopRequested = false;
+
+  const state = {
+    phase: "preparing",
+    done: 0,
+    total: 0,
+    predicted: 0,
+    skipped: 0,
+    missing: 0,
+    startedAt: Date.now(),
+    finishedAt: null,
+    message: null,
+  };
+
+  /** Footer buttons: Stop while running, Close once finished. */
+  const footer = () => {
+    if (FINISHED_PHASES.includes(state.phase)) {
+      return (
+        <div className="flex justify-end">
+          <Button onClick={() => modal.close()} data-testid="action-progress-close">
+            Close
+          </Button>
+        </div>
+      );
+    }
+
+    return (
+      <div className="flex justify-end">
+        <Button
+          look="outlined"
+          variant="neutral"
+          disabled={stopRequested} // one click is enough; the loop stops after the current batch
+          onClick={() => {
+            stopRequested = true;
+            update({ phase: "stopping" });
+          }}
+          data-testid="action-progress-stop"
+        >
+          Stop
+        </Button>
+      </div>
+    );
+  };
+
+  // allowClose / closeOnClickOutside = false: the run can only be ended with Stop, so the
+  // user can't hide the dialog and lose track of a run that is still going
+  const modal = Modal.modal({
+    title,
+    body: <ProgressBody state={{ ...state }} />,
+    footer: footer(),
+    allowClose: false,
+    closeOnClickOutside: false,
+    width: 560,
+  });
+
+  /**
+   * Merge new values into the state and redraw the dialog.
+   *
+   * @param {object} patch  Any of the state fields, e.g. { done: 20, predicted: 18 }.
+   */
+  const update = (patch) => {
+    Object.assign(state, patch);
+    // Freeze the elapsed time the first time the run reaches a finished phase
+    if (FINISHED_PHASES.includes(state.phase) && !state.finishedAt) {
+      state.finishedAt = Date.now();
+    }
+    // Pass a copy so React sees new props and re-renders
+    modal.update({ body: <ProgressBody state={{ ...state }} />, footer: footer() });
+  };
+
+  return {
+    update,
+    isStopRequested: () => stopRequested,
+  };
+};
